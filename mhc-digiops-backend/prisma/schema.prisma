// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int     @id @default(autoincrement())
  name            String
  email           String  @unique
  password        String
  role            String
  phone           String?
  gender          String?
  notifications   Notification []
  landApplications LandApplication []
}

model LandApplication {
  id        Int      @id @default(autoincrement())
  location  String
  status    String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  approval  Approval?
}

model Approval {
  id            Int    @id @default(autoincrement())
  decision      String
  applicationId Int    @unique
  application   LandApplication @relation(fields: [applicationId], references: [id])
}

model House {
  id       Int      @id @default(autoincrement())
  address  String
  location  String
  status    String
  latitude  Float
  longitude Float
  tenantId  Int
  tenants  Tenant   []
  paymentId Int
  payments Payment  []
  sensorData SensorData []
}

model Tenant {
  id         Int    @id @default(autoincrement())
  name       String
  rentStatus String
  houseId    Int
  house      House  @relation(fields: [houseId], references: [id])
  payments   Payment []
  maintenanceRequests MaintenanceRequest []
}

model Payment {
  id         Int      @id @default(autoincrement())
  amount     Float
  date       DateTime @default(now())
  tenantId   Int?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  houseId    Int?
  house      House?   @relation(fields: [houseId], references: [id])
  email      String?
  method     String?
  status     String?
  reference  String?  @unique
  externalId String?
}


model MaintenanceRequest {
  id          Int    @id @default(autoincrement())
  description String
  status      String
  tenantId    Int
  houseId     Int
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  
}

model Notification {
  id        Int    @id @default(autoincrement())
  message   String
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
}

model SensorData {
  id        Int      @id @default(autoincrement())
  type      String
  value     Float
  timestamp DateTime
  houseId   Int
  house     House    @relation(fields: [houseId], references: [id])
}

model LandAcquisition {
  id               Int      @id @default(autoincrement())
  formType         String
  sellerName       String
  nationalId       String
  region           String
  landLocation     String
  landSize         String
  ownershipProof   String
  purpose          String
  landMap          String
  villageChief     String?
  chiefSignature   String?
  witnessName      String?
  leaseDuration    String?
  agriculturalPlan String?
  valuationReport  String?
  ministryApproval String?
  notes            String?
  createdAt        DateTime @default(now())
}

